# Dash: nạp ~/.bashrc rồi báo lệnh vừa chạy và thư mục hiện tại cho Dash (OSC 633).
[ -f /etc/bash.bashrc ] && . /etc/bash.bashrc
[ -f ~/.bashrc ] && . ~/.bashrc
__dash_esc() { local s=${1//\\/\\\\}; s=${s//;/\\x3b}; s=${s//$'\n'/\\x0a}; printf '%s' "$s"; }
__dash_last=$(HISTTIMEFORMAT= builtin history 1)
__dash_prompt() {
  local ec=$? cur
  cur=$(HISTTIMEFORMAT= builtin history 1)
  if [ "$cur" != "$__dash_last" ]; then
    __dash_last=$cur
    printf '\e]633;E;%s\a\e]633;D;%s\a' "$(__dash_esc "$(sed 's/^ *[0-9]* *//' <<<"$cur")")" "$ec"
  fi
  printf '\e]633;P;Cwd=%s\a' "$(__dash_esc "$PWD")"
  return $ec
}
PROMPT_COMMAND="__dash_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
