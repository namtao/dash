{
  "name": "dash",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace local: dự án, terminal, git diff, Claude Code, database",
  "license": "MIT",
  "main": "server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server.js",
    "set-password": "node src/auth.js",
    "check": "node --check server.js && for f in src/*.js src/db/*.js public/app.js public/js/*.js; do node --check \"$f\" || exit 1; done",
    "service:install": "bash scripts/install-service.sh",
    "service:uninstall": "bash scripts/install-service.sh --uninstall"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.314",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "monaco-editor": "^0.57.0",
    "mssql": "^12.7.13",
    "mysql2": "^3.24.6",
    "node-pty": "^1.1.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "sql-formatter": "^15.9.0",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
